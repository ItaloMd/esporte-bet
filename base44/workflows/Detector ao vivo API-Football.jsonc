{
  "name": "Detector ao vivo API-Football",
  "description": "A cada 10 minutos consulta GET /fixtures?live=all: uma \u00fanica chamada global atualiza placares, minutos, status e tempo de jogo de todas as partidas em andamento e mant\u00e9m a fila de prioridades (minutos finais, favoritas, com apostas, padr\u00e3o). Nenhuma prioridade dispara chamada por partida. Sem jogo em andamento o detector desacelera para 15 minutos, e o intervalo configurado \u00e9 sempre respeitado.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "detector_ao_vivo_api_football",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "detectar_ao_vivo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootballLive",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Placar ao vivo (10 min)",
            "description": "live=all \u00b7 1 cr\u00e9dito cobre todas as partidas"
          }
        }
      }
    ]
  }
}