{
  "name": "Detector ao vivo API-Football",
  "description": "A cada 5 minutos consulta GET /fixtures?live=all: uma \u00fanica chamada detecta partidas iniciadas, atualiza placares, minutos, status e tempo de jogo, mant\u00e9m a fila de prioridades (cr\u00edtica 80'+, favoritas, com apostas, padr\u00e3o) e encerra o monitoramento no FT. O intervalo configurado \u00e9 respeitado; 5 minutos \u00e9 a cad\u00eancia m\u00ednima de agendamento da plataforma.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "detector_ao_vivo_api_football",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "detectar_ao_vivo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootballLive",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Detector global de jogos ao vivo",
            "description": "live=all \u00b7 1 cr\u00e9dito cobre todas as partidas"
          }
        }
      }
    ]
  }
}