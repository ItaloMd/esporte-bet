{
  "name": "Sincronizar cota\u00e7\u00f5es pr\u00e9-jogo",
  "description": "A cada 5 minutos, atualiza as cota\u00e7\u00f5es pr\u00e9-jogo das partidas curadas: monta a fila por relev\u00e2ncia, coleta em lotes de competi\u00e7\u00e3o + data dentro da janela de 7 dias e grava com a margem da casa. Respeita a fila global, o cache compartilhado, o teto por minuto e o or\u00e7amento di\u00e1rio; com a coleta pausada, nada \u00e9 consultado.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizar_cotacoes_pre_jogo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "atualizar_cotacoes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootballOdds",
            "args": {
              "mode": "auto",
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Atualizar cota\u00e7\u00f5es pr\u00e9-jogo",
            "description": "Fila por relev\u00e2ncia \u00b7 lotes competi\u00e7\u00e3o + data \u00b7 janela de 7 dias"
          }
        }
      }
    ]
  }
}