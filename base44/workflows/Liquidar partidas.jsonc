{
  "name": "Liquidar partidas",
  "description": "A cada 5 minutos audita em lote as partidas cujo hor\u00e1rio de auditoria venceu (in\u00edcio + 2 horas; at\u00e9 20 partidas por chamada), atualiza as cota\u00e7\u00f5es pr\u00e9-jogo dos jogos do dia e liquida os boletins com o resultado confirmado pela fonte. Nenhuma consulta \u00e9 feita durante o jogo antes do hor\u00e1rio de auditoria.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liquidar_partidas",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auditar_partidas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootball",
            "args": {
              "mode": "audit",
              "trigger": "scheduled"
            }
          },
          "then": "sincronizar_odds_futebol",
          "x-base44": {
            "title": "Auditar partidas vencidas",
            "description": "Em lote \u00b7 20 partidas por chamada"
          }
        }
      },
      {
        "sincronizar_odds_futebol": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootballOdds",
            "args": {
              "mode": "auto",
              "trigger": "scheduled"
            }
          },
          "then": "liquidar_partidas",
          "x-base44": {
            "title": "Atualizar cota\u00e7\u00f5es",
            "description": "API-Football \u00b7 uma coleta por hora por dia"
          }
        }
      },
      {
        "liquidar_partidas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "settleMatches",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Fechar apostas e liquidar",
            "description": "Somente resultado confirmado"
          }
        }
      }
    ]
  }
}