{
  "name": "Liquidar partidas",
  "description": "A cada 10 minutos sincroniza o calend\u00e1rio e os placares pela API-Football, atualiza as cota\u00e7\u00f5es pr\u00e9-jogo dos jogos do dia e liquida os boletins com o resultado confirmado pela fonte.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "America/Bahia",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liquidar_partidas",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_api_football": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootball",
            "args": {
              "mode": "auto",
              "trigger": "scheduled"
            }
          },
          "then": "sincronizar_odds_futebol",
          "x-base44": {
            "title": "Sincronizar calend\u00e1rio e placares",
            "description": "API-Football \u00b7 cache e or\u00e7amento di\u00e1rio"
          }
        }
      },
      {
        "sincronizar_odds_futebol": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootballOdds",
            "args": {
              "mode": "auto",
              "trigger": "scheduled"
            }
          },
          "then": "liquidar_partidas",
          "x-base44": {
            "title": "Atualizar cota\u00e7\u00f5es",
            "description": "API-Football \u00b7 uma coleta por hora por dia"
          }
        }
      },
      {
        "liquidar_partidas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "settleMatches",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Fechar apostas e liquidar",
            "description": "Somente resultado confirmado"
          }
        }
      }
    ]
  }
}