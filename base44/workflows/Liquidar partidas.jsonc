{
  "name": "Liquidar partidas",
  "description": "A cada 5 minutos consulta os resultados apenas das partidas com apostas pendentes (agrupadas por fixture: 200 apostas geram uma consulta, nunca 200). O resultado confirmado \u00e9 guardado e reutilizado por todos os bilhetes, a liquida\u00e7\u00e3o \u00e9 idempotente, as cota\u00e7\u00f5es pr\u00e9-jogo do dia s\u00e3o atualizadas e nenhuma partida sem aposta consome cr\u00e9ditos.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "3-58/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liquidar_partidas",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auditar_resultados_pendentes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "auditarResultadosPendentes",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "sincronizar_odds_futebol",
          "x-base44": {
            "title": "Auditar resultados pendentes",
            "description": "Somente partidas com apostas \u00b7 20 por chamada"
          }
        }
      },
      {
        "sincronizar_odds_futebol": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootballOdds",
            "args": {
              "mode": "auto",
              "trigger": "scheduled"
            }
          },
          "then": "liquidar_partidas",
          "x-base44": {
            "title": "Atualizar cota\u00e7\u00f5es",
            "description": "API-Football \u00b7 uma coleta por hora por dia"
          }
        }
      },
      {
        "liquidar_partidas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "settleMatches",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Fechar apostas e liquidar",
            "description": "Somente resultado confirmado"
          }
        }
      }
    ]
  }
}