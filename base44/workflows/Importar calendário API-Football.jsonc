{
  "name": "Importar calend\u00e1rio API-Football",
  "description": "Todo dia \u00e0s 00:10 importa as partidas do dia e do dia seguinte em lote: uma chamada por data, sem nenhuma consulta ao vivo. Cada partida importada recebe o hor\u00e1rio da primeira auditoria (in\u00edcio + 2 horas).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "10 0 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "importar_calendario_api_football",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "importar_calendario": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootball",
            "args": {
              "mode": "calendar",
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Importar dia e dia seguinte",
            "description": "Uma chamada por data \u00b7 auditoria em in\u00edcio + 2h"
          }
        }
      }
    ]
  }
}