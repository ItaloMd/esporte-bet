{
  "name": "Importar calend\u00e1rio API-Football",
  "description": "Uma vez ao dia, importa em lote as partidas de hoje e dos pr\u00f3ximos 6 dias (janela de 7 dias): uma chamada por data, sem nenhuma consulta ao vivo. Cada data fica em cache por 24 horas, ent\u00e3o n\u00e3o \u00e9 reconsultada no mesmo dia. Cada partida importada recebe o hor\u00e1rio da primeira auditoria (in\u00edcio + 2 horas).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "12 0 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "importar_calendario_api_football",
      "version": "1.3",
      "namespace": "base44"
    },
    "do": [
      {
        "importar_calendario": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFootball",
            "args": {
              "mode": "calendar",
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Importar hoje e pr\u00f3ximos 6 dias",
            "description": "Uma chamada por data \u00b7 uma vez ao dia \u00b7 auditoria em in\u00edcio + 2h"
          }
        }
      }
    ]
  }
}