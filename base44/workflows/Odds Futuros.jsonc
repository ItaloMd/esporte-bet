{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "odds_futuros",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_odds_futuros": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncOdds",
            "args": {
              "mode": "upcoming",
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar pr\u00f3ximos 7 dias",
            "description": "Cat\u00e1logo + odds pr\u00e9-jogo"
          }
        }
      }
    ]
  },
  "description": "Sincroniza diariamente o cat\u00e1logo e as odds dos pr\u00f3ximos sete dias.",
  "name": "Odds Futuros",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/Bahia",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}