{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "default": "Placar"
    },
    "tagline": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "favicon_url": {
      "type": "string"
    },
    "support_email": {
      "type": "string"
    },
    "demo_mode": {
      "type": "boolean",
      "default": true
    },
    "min_age": {
      "type": "number",
      "default": 18
    },
    "terms_text": {
      "type": "string"
    },
    "privacy_text": {
      "type": "string"
    },
    "responsible_gaming_text": {
      "type": "string"
    },
    "affiliate_enabled": {
      "type": "boolean",
      "default": true
    },
    "affiliate_attribution_days": {
      "type": "number",
      "default": 30
    },
    "affiliate_max_referrals": {
      "type": "number",
      "default": 50
    },
    "affiliate_approval_required": {
      "type": "boolean",
      "default": true
    },
    "affiliate_commission_rule": {
      "type": "string"
    },
    "deposits_enabled": {
      "type": "boolean",
      "default": true
    },
    "withdrawals_enabled": {
      "type": "boolean",
      "default": true
    },
    "min_deposit": {
      "type": "number",
      "default": 10
    },
    "min_withdrawal": {
      "type": "number",
      "default": 30
    },
    "rollover_multiplier": {
      "type": "number",
      "default": 1
    },
    "withdrawal_fee": {
      "type": "number",
      "default": 3
    },
    "dev_split_percent": {
      "type": "number",
      "default": 10
    },
    "dev_pix_key": {
      "type": "string"
    },
    "dev_pix_key_type": {
      "type": "string",
      "default": "cpf"
    },
    "admin_pix_key": {
      "type": "string"
    },
    "admin_pix_key_type": {
      "type": "string",
      "default": "cpf"
    }
  },
  "required": [
    "brand_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}