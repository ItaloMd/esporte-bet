{
  "name": "MatchMonitorQueue",
  "type": "object",
  "properties": {
    "fixture_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "home_team_name": {
      "type": "string"
    },
    "away_team_name": {
      "type": "string"
    },
    "competition_name": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "default": 1
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "live",
        "finished",
        "removed"
      ],
      "default": "queued"
    },
    "has_bets": {
      "type": "boolean",
      "default": false
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_critical": {
      "type": "boolean",
      "default": false
    },
    "score": {
      "type": "string"
    },
    "minute": {
      "type": "number"
    },
    "next_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "fixture_id",
    "event_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}