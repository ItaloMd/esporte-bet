{
  "name": "SimulationResult",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "won",
        "lost",
        "void",
        "partial"
      ],
      "default": "void"
    },
    "points_returned": {
      "type": "number",
      "default": 0
    },
    "selections_settled": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "provider"
      ],
      "default": "demo"
    },
    "note": {
      "type": "string"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ticket_id",
    "user_id",
    "result"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}