{
  "name": "Event",
  "type": "object",
  "properties": {
    "sport_slug": {
      "type": "string"
    },
    "competition_id": {
      "type": "string"
    },
    "competition_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "home_team_id": {
      "type": "string"
    },
    "home_team_name": {
      "type": "string"
    },
    "home_team_crest": {
      "type": "string"
    },
    "away_team_id": {
      "type": "string"
    },
    "away_team_name": {
      "type": "string"
    },
    "away_team_crest": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "local_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "finished",
        "postponed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "tracking": {
      "type": "string",
      "enum": [
        "today",
        "upcoming",
        "finished"
      ],
      "default": "upcoming"
    },
    "odds_status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "stale"
      ],
      "default": "unavailable"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "odds_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_checks": {
      "type": "number",
      "default": 0
    },
    "minute": {
      "type": "number"
    },
    "home_score": {
      "type": "number"
    },
    "away_score": {
      "type": "number"
    },
    "ht_home_score": {
      "type": "number"
    },
    "ht_away_score": {
      "type": "number"
    },
    "reg_home_score": {
      "type": "number"
    },
    "reg_away_score": {
      "type": "number"
    },
    "corners_home": {
      "type": "number"
    },
    "corners_away": {
      "type": "number"
    },
    "cards_home": {
      "type": "number"
    },
    "cards_away": {
      "type": "number"
    },
    "first_goal_minute": {
      "type": "number"
    },
    "first_goal_team": {
      "type": "string"
    },
    "extra_time": {
      "type": "boolean",
      "default": false
    },
    "penalties": {
      "type": "boolean",
      "default": false
    },
    "venue": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "popularity": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "provider"
      ],
      "default": "demo"
    },
    "external_id": {
      "type": "string"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "fixture_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "phase_label": {
      "type": "string"
    },
    "result_source": {
      "type": "string"
    },
    "result_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "settlement_state": {
      "type": "string",
      "enum": [
        "none",
        "waiting",
        "review",
        "settled"
      ],
      "default": "none"
    }
  },
  "required": [
    "sport_slug",
    "home_team_name",
    "away_team_name",
    "start_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}