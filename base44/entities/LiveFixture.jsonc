{
  "name": "LiveFixture",
  "type": "object",
  "properties": {
    "fixture_id": {
      "type": "string",
      "description": "ID da partida na API-Football: chave \u00fanica da tabela live_fixtures."
    },
    "event_id": {
      "type": "string",
      "description": "Partida correspondente no cat\u00e1logo interno (Event)."
    },
    "status": {
      "type": "string",
      "description": "Status oficial da API (1H, HT, 2H, ET, FT...)."
    },
    "elapsed": {
      "type": "number",
      "description": "Minuto de jogo informado pela fonte."
    },
    "league_id": {
      "type": "string"
    },
    "league_name": {
      "type": "string"
    },
    "home_id": {
      "type": "string"
    },
    "home_name": {
      "type": "string"
    },
    "away_id": {
      "type": "string"
    },
    "away_name": {
      "type": "string"
    },
    "home_score": {
      "type": "number"
    },
    "away_score": {
      "type": "number"
    },
    "has_bets": {
      "type": "boolean",
      "default": false,
      "description": "Partida com aposta aberta: prioridade m\u00e1xima nas rotinas."
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_brazilian": {
      "type": "boolean",
      "default": false
    },
    "last_update": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da \u00faltima leitura feita pelo coletor ao vivo."
    }
  },
  "required": [
    "fixture_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}