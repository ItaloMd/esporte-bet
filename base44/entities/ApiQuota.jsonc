{
  "name": "ApiQuota",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "default": "api_football"
    },
    "day": {
      "type": "string"
    },
    "used": {
      "type": "number",
      "default": 0
    },
    "limit": {
      "type": "number",
      "default": 100
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "provider_limit": {
      "type": "number"
    },
    "provider_remaining": {
      "type": "number",
      "description": "Tokens restantes informados pelo provedor (x-ratelimit-requests-remaining). Base do token bucket global."
    },
    "provider_used": {
      "type": "number"
    },
    "provider_minute_limit": {
      "type": "number",
      "description": "Limite por minuto informado pelo provedor (X-RateLimit-Limit). Teto aplicado \u00e0 janela de 60 s."
    },
    "provider_minute_remaining": {
      "type": "number",
      "description": "Requisi\u00e7\u00f5es restantes no minuto corrente segundo o provedor (X-RateLimit-Remaining)."
    },
    "provider_minute_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da leitura de X-RateLimit-Remaining: s\u00f3 vale para o minuto registrado."
    },
    "purpose_used": {
      "type": "string",
      "description": "Consumo por finalidade em JSON: {\"live\":0,\"odds\":0,\"audit\":0,\"emergency\":0}."
    },
    "blocked_endpoints": {
      "type": "string",
      "description": "Disjuntores abertos em JSON: {\"/fixtures\":{\"until\":\"...\",\"strikes\":1}}."
    },
    "minute_key": {
      "type": "string",
      "description": "Chave do minuto corrente (UTC) do contador de requisi\u00e7\u00f5es por minuto, compartilhado por todas as rotinas."
    },
    "minute_used": {
      "type": "number",
      "default": 0,
      "description": "Requisi\u00e7\u00f5es j\u00e1 feitas no minuto corrente (balde compartilhado)."
    },
    "last_slot_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo hor\u00e1rio reservado na fila global de requisi\u00e7\u00f5es. O slot seguinte fica 200 ms depois, garantindo no m\u00e1ximo 5 chamadas por segundo (300/min) entre todas as execu\u00e7\u00f5es."
    },
    "rate_pause_until": {
      "type": "string",
      "format": "date-time",
      "description": "Pausa de seguran\u00e7a ap\u00f3s HTTP 429 ou minuto fechado pelo X-RateLimit-Remaining: nenhuma requisi\u00e7\u00e3o \u00e0 API \u00e9 feita at\u00e9 este hor\u00e1rio."
    },
    "rate_limit_strikes": {
      "type": "number",
      "default": 0,
      "description": "Ocorr\u00eancias consecutivas de limite excedido: cada uma sobe um degrau no backoff exponencial das retentativas."
    },
    "last_rate_limited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio da \u00faltima resposta de limite excedido (HTTP 429) recebida do provedor."
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_status_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_status_code": {
      "type": "number"
    },
    "last_error": {
      "type": "string"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    },
    "lock_owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "day"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}