{
  "name": "ApiQuota",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "default": "api_football"
    },
    "day": {
      "type": "string"
    },
    "used": {
      "type": "number",
      "default": 0
    },
    "limit": {
      "type": "number",
      "default": 100
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "provider_limit": {
      "type": "number"
    },
    "provider_remaining": {
      "type": "number",
      "description": "Requisi\u00e7\u00f5es restantes no dia informadas pelo provedor (x-ratelimit-requests-remaining). Fonte da verdade do saldo di\u00e1rio."
    },
    "provider_used": {
      "type": "number"
    },
    "provider_minute_limit": {
      "type": "number",
      "description": "Limite por minuto informado pelo provedor (X-RateLimit-Limit). Teto aplicado \u00e0 janela de 60 s."
    },
    "provider_minute_remaining": {
      "type": "number",
      "description": "Requisi\u00e7\u00f5es restantes no minuto corrente segundo o provedor (X-RateLimit-Remaining)."
    },
    "provider_minute_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da leitura de X-RateLimit-Remaining: s\u00f3 vale para o minuto registrado."
    },
    "purpose_used": {
      "type": "string",
      "description": "Consumo por finalidade em JSON: {\"live\":0,\"odds\":0,\"audit\":0}."
    },
    "blocked_endpoints": {
      "type": "string",
      "description": "Reservado a disjuntores por endpoint (legado)."
    },
    "minute_key": {
      "type": "string",
      "description": "Chave do minuto corrente (UTC) do contador de requisi\u00e7\u00f5es por minuto, compartilhado por todas as rotinas."
    },
    "minute_used": {
      "type": "number",
      "default": 0,
      "description": "Requisi\u00e7\u00f5es j\u00e1 feitas no minuto corrente (balde compartilhado)."
    },
    "second_key": {
      "type": "string",
      "description": "Chave do segundo corrente (UTC): janela de 1 s compartilhada, teto interno de 4 requisi\u00e7\u00f5es."
    },
    "second_used": {
      "type": "number",
      "default": 0,
      "description": "Requisi\u00e7\u00f5es j\u00e1 feitas no segundo corrente."
    },
    "last_slot_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo hor\u00e1rio reservado na fila global: o slot seguinte fica um espa\u00e7amento depois, garantindo chamadas nunca simult\u00e2neas entre execu\u00e7\u00f5es."
    },
    "request_gap_ms": {
      "type": "number",
      "description": "Espa\u00e7amento aprendido entre chamadas (230 a 5000 ms). Dobra a cada limite do provedor e cai 20% ap\u00f3s uma sequ\u00eancia de sucessos."
    },
    "success_streak": {
      "type": "number",
      "default": 0,
      "description": "Sucessos consecutivos desde o \u00faltimo limite; usado para voltar a acelerar o ritmo aos poucos."
    },
    "rate_pause_until": {
      "type": "string",
      "format": "date-time",
      "description": "Pausa por limite de minuto: nenhuma requisi\u00e7\u00e3o \u00e0 API \u00e9 feita at\u00e9 este hor\u00e1rio (pr\u00f3ximo minuto ou Retry-After do provedor)."
    },
    "rate_limit_strikes": {
      "type": "number",
      "default": 0,
      "description": "Ocorr\u00eancias consecutivas de limite por minuto; zera na primeira chamada bem-sucedida."
    },
    "last_rate_limited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio da \u00faltima resposta de limite por minuto (HTTP 429)."
    },
    "last_rate_scope": {
      "type": "string",
      "enum": [
        "minute",
        "daily"
      ],
      "description": "Qual limite foi excedido na \u00faltima ocorr\u00eancia."
    },
    "daily_blocked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Saldo di\u00e1rio do provedor esgotado: nenhuma rotina chama a API-Football at\u00e9 a virada do dia na conta (00:00 UTC)."
    },
    "daily_blocked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o bloqueio di\u00e1rio foi registrado."
    },
    "breaker_failures": {
      "type": "number",
      "default": 0,
      "description": "Falhas duras consecutivas do provedor (5xx, tempo esgotado, rede). O disjuntor abre ao atingir o limite da pol\u00edtica."
    },
    "breaker_open_until": {
      "type": "string",
      "format": "date-time",
      "description": "Disjuntor aberto: nenhuma chamada \u00e9 feita ao provedor at\u00e9 este hor\u00e1rio, que dobra a cada abertura consecutiva."
    },
    "breaker_opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da \u00faltima abertura do disjuntor."
    },
    "breaker_reason": {
      "type": "string",
      "description": "Motivo registrado na abertura do disjuntor."
    },
    "breaker_trips": {
      "type": "number",
      "default": 0,
      "description": "Aberturas consecutivas sem nenhuma chamada bem-sucedida entre elas."
    },
    "breaker_last_failure_at": {
      "type": "string",
      "format": "date-time"
    },
    "cache_hits": {
      "type": "number",
      "default": 0,
      "description": "Respostas servidas do cache compartilhado sem nenhuma requisi\u00e7\u00e3o ao provedor."
    },
    "cache_misses": {
      "type": "number",
      "default": 0,
      "description": "Consultas que n\u00e3o encontraram resposta v\u00e1lida em cache e precisaram ir ao provedor."
    },
    "dedupe_hits": {
      "type": "number",
      "default": 0,
      "description": "Requisi\u00e7\u00f5es evitadas porque outra execu\u00e7\u00e3o j\u00e1 estava buscando exatamente o mesmo dado."
    },
    "call_count": {
      "type": "number",
      "default": 0,
      "description": "Requisi\u00e7\u00f5es efetivamente enviadas ao provedor no dia."
    },
    "total_duration_ms": {
      "type": "number",
      "default": 0,
      "description": "Soma dos tempos de resposta das requisi\u00e7\u00f5es enviadas (base do tempo m\u00e9dio)."
    },
    "count_429": {
      "type": "number",
      "default": 0,
      "description": "Respostas de limite excedido (HTTP 429) no dia."
    },
    "errors_5xx": {
      "type": "number",
      "default": 0,
      "description": "Falhas do provedor (HTTP 5xx ou indisponibilidade) no dia."
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_status_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_status_code": {
      "type": "number"
    },
    "last_error": {
      "type": "string"
    },
    "last_error_scope": {
      "type": "string",
      "description": "Natureza do \u00faltimo erro: minute, daily, auth, plan, breaker."
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    },
    "lock_owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "day"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}