{
  "name": "ApiUsageLog",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "status_code": {
      "type": "number"
    },
    "duration_ms": {
      "type": "number"
    },
    "records_returned": {
      "type": "number"
    },
    "cache_hit": {
      "type": "boolean",
      "default": false
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "endpoint"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}