{
  "name": "Odd",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "market_id": {
      "type": "string"
    },
    "market_name": {
      "type": "string"
    },
    "market_group": {
      "type": "string"
    },
    "market_key": {
      "type": "string"
    },
    "bookmaker": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "line": {
      "type": "number"
    },
    "value": {
      "type": "number"
    },
    "original_value": {
      "type": "number"
    },
    "house_margin_percent": {
      "type": "number"
    },
    "calc_version": {
      "type": "string"
    },
    "original_overround": {
      "type": "number"
    },
    "target_overround": {
      "type": "number"
    },
    "offered_overround": {
      "type": "number"
    },
    "quote_state": {
      "type": "string",
      "enum": [
        "offered",
        "withheld"
      ],
      "default": "offered"
    },
    "previous_value": {
      "type": "number"
    },
    "movement": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "stable"
      ],
      "default": "stable"
    },
    "is_super_odd": {
      "type": "boolean",
      "default": false
    },
    "super_odd_value": {
      "type": "number"
    },
    "super_odd_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "suspended",
        "closed"
      ],
      "default": "open"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "provider"
      ],
      "default": "demo"
    },
    "source_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_id": {
      "type": "string"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "market_id",
    "label",
    "value"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}