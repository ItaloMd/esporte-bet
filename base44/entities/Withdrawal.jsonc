{
  "name": "Withdrawal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "player",
        "affiliate",
        "admin",
        "dev_split",
        "simulated"
      ],
      "default": "player"
    },
    "gateway": {
      "type": "string",
      "enum": [
        "payshark"
      ],
      "default": "payshark"
    },
    "affiliate_code": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "sent_amount": {
      "type": "number",
      "default": 0
    },
    "fee": {
      "type": "number",
      "default": 0
    },
    "net_amount": {
      "type": "number",
      "default": 0
    },
    "retained_amount": {
      "type": "number",
      "default": 0,
      "description": "Reten\u00e7\u00e3o de 20% deste saque, acumulada no saldo retido do dono."
    },
    "retention_applies": {
      "type": "boolean",
      "default": false,
      "description": "Marcado quando a reten\u00e7\u00e3o de 20% se aplica (saque de caixa ou carteira de administrador)."
    },
    "pix_key": {
      "type": "string"
    },
    "pix_key_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "rejected"
      ],
      "default": "pending"
    },
    "correlation_id": {
      "type": "string"
    },
    "gateway_id": {
      "type": "string"
    },
    "gateway_txid": {
      "type": "string"
    },
    "gateway_e2eid": {
      "type": "string"
    },
    "failure_reason": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "parent_withdrawal_id": {
      "type": "string"
    },
    "dev_split_amount": {
      "type": "number",
      "default": 0
    },
    "dev_split_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "sent",
        "failed"
      ],
      "default": "none"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}