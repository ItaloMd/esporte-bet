{
  "name": "AffiliateReferral",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string"
    },
    "referred_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "fraud"
      ],
      "default": "pending"
    },
    "source": {
      "type": "string",
      "default": "link"
    },
    "attributed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "referrer_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}