{
  "name": "Competition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "sport_slug": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "external_id": {
      "type": "string"
    },
    "odds_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "sport_slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}