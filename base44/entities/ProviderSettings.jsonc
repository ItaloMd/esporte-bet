{
  "name": "ProviderSettings",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "demo",
        "the_odds_api",
        "api_football",
        "sportradar",
        "custom"
      ],
      "default": "demo"
    },
    "provider_label": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "base_url": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "eu"
      ]
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "h2h",
        "spreads",
        "totals"
      ]
    },
    "sports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "house_margin_percent": {
      "type": "number",
      "default": 20
    },
    "house_margin_version": {
      "type": "string",
      "default": "v1"
    },
    "max_sports_per_run": {
      "type": "number",
      "default": 10
    },
    "max_bookmakers": {
      "type": "number",
      "default": 8
    },
    "budget_credits": {
      "type": "number",
      "default": 0
    },
    "credits_used": {
      "type": "number",
      "default": 0
    },
    "credits_remaining": {
      "type": "number"
    },
    "credits_last": {
      "type": "number",
      "default": 0
    },
    "credits_today": {
      "type": "number",
      "default": 0
    },
    "credits_today_date": {
      "type": "string"
    },
    "credits_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "alert_level": {
      "type": "number",
      "default": 0
    },
    "skipped_queries": {
      "type": "number",
      "default": 0
    },
    "skipped_reason": {
      "type": "string"
    },
    "catalog_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "today_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "upcoming_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_today_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_upcoming_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time"
    },
    "lock_owner": {
      "type": "string"
    },
    "last_run_summary": {
      "type": "string"
    },
    "refresh_live_seconds": {
      "type": "number",
      "default": 60
    },
    "refresh_upcoming_seconds": {
      "type": "number",
      "default": 3600
    },
    "refresh_finished_seconds": {
      "type": "number",
      "default": 86400
    },
    "cache_ttl_seconds": {
      "type": "number",
      "default": 600
    },
    "batch_odds": {
      "type": "boolean",
      "default": true
    },
    "webhook_enabled": {
      "type": "boolean",
      "default": false
    },
    "daily_request_limit": {
      "type": "number",
      "default": 500
    },
    "credentials_configured": {
      "type": "boolean",
      "default": false
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_status": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "football_enabled": {
      "type": "boolean",
      "default": false
    },
    "football_base_url": {
      "type": "string",
      "default": "https://v3.football.api-sports.io"
    },
    "football_daily_limit": {
      "type": "number",
      "default": 100
    },
    "football_window_days": {
      "type": "number",
      "default": 7
    },
    "football_calendar_refresh_seconds": {
      "type": "number",
      "default": 21600
    },
    "football_live_refresh_seconds": {
      "type": "number",
      "default": 300
    },
    "football_live_idle_seconds": {
      "type": "number",
      "default": 900
    },
    "football_live_discover_seconds": {
      "type": "number",
      "default": 1800
    },
    "football_create_events": {
      "type": "boolean",
      "default": true
    },
    "football_last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "football_last_live_at": {
      "type": "string",
      "format": "date-time"
    },
    "football_last_calendar_at": {
      "type": "string",
      "format": "date-time"
    },
    "football_last_status": {
      "type": "string"
    },
    "football_last_error": {
      "type": "string"
    },
    "football_last_summary": {
      "type": "string"
    },
    "football_alert_level": {
      "type": "number",
      "default": 0
    },
    "football_next_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "football_account_limit": {
      "type": "number"
    },
    "football_account_remaining": {
      "type": "number"
    },
    "football_plan": {
      "type": "string"
    },
    "football_plan_note": {
      "type": "string"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}