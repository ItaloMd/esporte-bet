{
  "name": "SuperMultiple",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da m\u00faltipla exibido na vitrine (ex.: Combo da Rodada)."
    },
    "subtitle": {
      "type": "string"
    },
    "selections": {
      "type": "string",
      "description": "Sele\u00e7\u00f5es da m\u00faltipla em JSON: [{odd_id, event_id, market_id, market_name, label, odd_value, event_label, competition_name, start_time}]. A cota\u00e7\u00e3o vigente \u00e9 lida do registro da odd na hora de exibir."
    },
    "legs": {
      "type": "number",
      "default": 0
    },
    "base_odd": {
      "type": "number",
      "default": 0,
      "description": "Produto das cota\u00e7\u00f5es no momento da montagem."
    },
    "boost_percent": {
      "type": "number",
      "default": 0,
      "description": "Percentual de turbina\u00e7\u00e3o aplicado \u00e0 odd total da m\u00faltipla."
    },
    "boosted_odd": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "enumColors": [
        "gray",
        "green",
        "red"
      ]
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}