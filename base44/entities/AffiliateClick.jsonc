{
  "name": "AffiliateClick",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "landing_path": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "is_suspect": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}