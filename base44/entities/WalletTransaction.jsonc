{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "bet",
        "cashout",
        "prize",
        "adjustment"
      ],
      "default": "bet"
    },
    "amount": {
      "type": "number"
    },
    "balance_after": {
      "type": "number",
      "default": 0
    },
    "reference_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "kind",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}