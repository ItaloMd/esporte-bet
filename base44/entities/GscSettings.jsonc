{
  "name": "GscSettings",
  "type": "object",
  "properties": {
    "operator_code": {
      "type": "string",
      "description": "C\u00f3digo do operador fornecido pela GamingSoft."
    },
    "operator_name": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "staging",
        "production"
      ],
      "default": "staging",
      "enumColors": [
        "yellow",
        "green"
      ],
      "description": "Ambiente da API GSC+ em uso. Produ\u00e7\u00e3o s\u00f3 deve ser ativada ap\u00f3s valida\u00e7\u00e3o comercial e de reconcilia\u00e7\u00e3o."
    },
    "api_base_url": {
      "type": "string",
      "default": "https://api.gscplus.com"
    },
    "currency": {
      "type": "string",
      "default": "BRL"
    },
    "locale": {
      "type": "string",
      "default": "pt-BR"
    },
    "return_url": {
      "type": "string",
      "description": "P\u00e1gina para onde o jogador volta ao encerrar a sess\u00e3o de jogo."
    },
    "secret_name": {
      "type": "string",
      "default": "GSC_SECRET_KEY",
      "description": "Nome do segredo (p\u00e1gina Secrets) que guarda a chave secreta do operador. A chave nunca \u00e9 gravada no banco."
    },
    "secret_configured": {
      "type": "boolean",
      "default": false,
      "description": "Marcado quando a chave secreta foi cadastrada nos segredos do servidor."
    },
    "allowed_ips": {
      "type": "string",
      "description": "IPs de origem do provedor, separados por v\u00edrgula. Usados para validar as chamadas de carteira."
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Liga a integra\u00e7\u00e3o. Enquanto desligada, nenhuma rotina chama a GSC+."
    },
    "demo_enabled": {
      "type": "boolean",
      "default": true
    },
    "real_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Sess\u00f5es com saldo real. Exige valida\u00e7\u00e3o regulat\u00f3ria e de carteira conclu\u00eddas."
    },
    "min_bet": {
      "type": "number",
      "default": 1
    },
    "max_bet": {
      "type": "number",
      "default": 500
    },
    "last_status": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "last_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "catalog_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "games_total": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "operator_code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}